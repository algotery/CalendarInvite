PORT=3000
NODE_ENV=development
TOKEN_ENCRYPTION_KEY=your-64-char-hex-key-here-generate-with-openssl-rand-hex-32
SESSION_SECRET=your-session-secret-at-least-32-chars

# Database (use "db" as host when running with docker-compose)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/calendar_invite

# Redis (required in production for sessions + job queue)
REDIS_URL=redis://localhost:6379

# Entry mode: "all" (api+worker), "api" (server only), "worker" (queue processor only)
ENTRY_MODE=all

# Static assets URL (CloudFront distribution URL in production, empty for local)
STATIC_ASSETS_URL=

# AWS (production — SES email delivery)
AWS_REGION=eu-central-1
AWS_SES_FROM_EMAIL=noreply@yourdomain.com

# SMTP (alternative to SES for local dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Google Calendar OAuth2
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/admin/calendars/callback/google

# Microsoft OAuth2 (Office 365 Calendar)
MICROSOFT_CLIENT_ID=your-azure-app-client-id
MICROSOFT_CLIENT_SECRET=your-azure-app-client-secret
MICROSOFT_REDIRECT_URI=http://localhost:3000/admin/calendars/callback/microsoft
MICROSOFT_TENANT_ID=common

# Zoho Calendar OAuth2
ZOHO_CLIENT_ID=your-zoho-client-id
ZOHO_CLIENT_SECRET=your-zoho-client-secret
ZOHO_REDIRECT_URI=http://localhost:3000/admin/calendars/zoho/callback
# Zoho region: accounts.zoho.com (US), accounts.zoho.eu (EU), accounts.zoho.in (IN), accounts.zoho.com.au (AU)
ZOHO_ACCOUNTS_SERVER=https://accounts.zoho.com
